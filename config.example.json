{
  "port": 4318,
  "hosts": [
    {
      "id": "local",
      "name": "MacBook Pro",
      "codex": "/Applications/ChatGPT.app/Contents/Resources/codex",
      "python": "python3",
      "codexVersions": ["0.155.1", "0.155.0-alpha.9.2", "0.154.0-alpha.6.2"]
    },
    {
      "id": "server",
      "name": "Build Server",
      "ssh": "your-user@your-existing-ssh-host",
      "codex": "/usr/lib/chatgpt/resources/codex",
      "codexVersions": ["0.151.0-alpha.7.2"]
    }
  ],
  "sources": [
    {
      "id": "claude-local",
      "name": "Claude Code",
      "adapter": "claude",
      "hostId": "local",
      "projectsDir": "/Users/you/.claude/projects",
      "sessionsDir": "/Users/you/.claude/sessions",
      "maxSessions": 500,
      "locality": { "providers": { "anthropic": "cloud" } }
    },
    {
      "id": "hermes-server",
      "name": "Hermes",
      "adapter": "hermes",
      "hostId": "server",
      "baseUrl": "http://127.0.0.1:9119",
      "tokenFile": "/home/you/.config/threadhelm/hermes-dashboard.token",
      "profiles": [
        "default",
        "qwen-local",
        "peaktasks",
        "peaktasks-sonnet",
        "peaktasks-webchat"
      ],
      "locality": { "profiles": { "qwen-local": "local" } }
    },
    {
      "id": "openclaw-server",
      "name": "OpenClaw",
      "adapter": "openclaw",
      "hostId": "server",
      "baseUrl": "ws://127.0.0.1:18789",
      "tokenFile": "/home/you/.config/threadhelm/openclaw-bootstrap.token",
      "deviceFile": "/home/you/.config/threadhelm/openclaw-device.json",
      "configuredAgentsOnly": true,
      "locality": { "providers": { "your-cloud-provider": "cloud" } }
    },
    {
      "id": "openwebui-server",
      "name": "Open WebUI",
      "adapter": "openwebui",
      "hostId": "server",
      "baseUrl": "http://127.0.0.1:3000",
      "tokenFile": "/home/you/.config/threadhelm/openwebui-owner.token"
    }
  ],
  "supervisorName": "Astra",
  "coordinator": {
    "model": "gpt-5.6-terra",
    "reasoningEffort": "xhigh",
    "maxActions": 12,
    "maxInputChars": 800000
  },
  "shadowAnalysis": {
    "enabled": false,
    "model": "gpt-5.6-luna",
    "reasoningEffort": "medium",
    "intervalSeconds": 900,
    "dailyCallLimit": 20,
    "observableTokenLimit": 100000,
    "maxExcerptChars": 4000,
    "localOnlyProjects": [
      { "hostId": "server", "projectId": "private-local-project" }
    ]
  },
  "runtime": {
    "id": "gpu-broker",
    "name": "Local model broker",
    "hostId": "server",
    "baseUrl": "http://127.0.0.1:8082",
    "loadedModelUrls": [
      "http://127.0.0.1:8083/models",
      "http://127.0.0.1:8085/models",
      "http://127.0.0.1:11434/api/ps"
    ]
  }
}
