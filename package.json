{
  "name": "threadhelm",
  "version": "0.4.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/server.ts",
    "demo": "tsx src/server.ts --demo",
    "doctor": "python3 scripts/doctor.py",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "tsx --test tests/*.test.ts && python3 -m unittest discover -s tests -p '*_test.py'"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "description": "Self-hosted coordination for coding agents across machines and repositories.",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/shadoprizm/threadhelm.git"
  },
  "dependencies": {
    "@openclaw/gateway-client": "2026.8.1",
    "@openclaw/gateway-protocol": "2026.8.1",
    "jose": "^6.2.12"
  }
}
